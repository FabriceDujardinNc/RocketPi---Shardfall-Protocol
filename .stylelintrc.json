{
    "extends": ["stylelint-config-standard"],
    "ignoreFiles": [
        "node_modules/**",
        "public/build/**",
        "public/game/**",
        "vendor/**",
        "storybook-static/**",
        "resources/css/app.css"
    ],
    "rules": {
        "color-no-hex": [
            true,
            { "message": "❌ Couleur hex interdite. Utilise les variables CSS du Design System (var(--color-shard-500)…)." }
        ],
        "color-named": [
            "never",
            { "message": "❌ Couleurs nommées (red, blue…) interdites. Utilise les tokens du Design System." }
        ],
        "color-no-invalid-hex": true,
        "no-empty-source": null,
        "selector-class-pattern": null,
        "at-rule-no-unknown": [
            true,
            { "ignoreAtRules": ["theme", "tailwind", "apply", "variants", "responsive", "screen", "layer"] }
        ],
        "custom-property-pattern": null,
        "media-feature-name-no-unknown": [true, {"ignoreMediaFeatureNames": ["theme"]}],
        "import-notation": null
    }
}
