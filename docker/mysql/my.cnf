[mysqld]
character-set-server     = utf8mb4
collation-server         = utf8mb4_unicode_ci
# Note: `default-authentication-plugin` retiré en MySQL 8.4.
# `caching_sha2_password` est le défaut depuis 8.0 — pas besoin de l'imposer.

# ── Performance ─────────────────────────────────────────────────────
# Adapter innodb_buffer_pool_size selon RAM disponible sur le VPS.
# Règle : 70-80% de la RAM si MySQL est la seule DB.
# VPS Hostinger 8Go → 4Go buffer pool.
innodb_buffer_pool_size  = 512M    # à augmenter en prod selon RAM
# Note: `innodb_log_file_size` est déprécié — utiliser `innodb_redo_log_capacity`.
innodb_redo_log_capacity = 256M    # remplace innodb_log_file_size × innodb_log_files_in_group
innodb_flush_log_at_trx_commit = 2  # Compromis durabilité/perf (1 = full ACID)
innodb_flush_method      = O_DIRECT
# Note: `query_cache_type` retiré en MySQL 8.0+.

# ── Connexions ──────────────────────────────────────────────────────
max_connections          = 150
connect_timeout          = 10
wait_timeout             = 600
interactive_timeout      = 600

# ── Logging ─────────────────────────────────────────────────────────
slow_query_log           = 1
slow_query_log_file      = /var/log/mysql/slow.log
long_query_time          = 2        # Log les requêtes > 2 secondes
log_queries_not_using_indexes = 1   # Détecte les scans full table

# ── Binlog (pour réplication future) ────────────────────────────────
server-id                = 1
log_bin                  = /var/log/mysql/binlog
# `binlog_format` est déprécié en 8.4 (sera retiré). ROW reste le défaut donc on peut l'omettre.
binlog_expire_logs_seconds = 604800  # 7 jours (remplace expire_logs_days)

[mysql]
default-character-set    = utf8mb4

[client]
default-character-set    = utf8mb4
