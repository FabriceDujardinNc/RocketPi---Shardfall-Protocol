APP_NAME="RocketPi — Shardfall Protocol"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://rocketpi.pro
APP_VERSION=0.1.0

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=rocketpi
DB_USERNAME=rocketpi
DB_PASSWORD=

# MySQL root (Docker uniquement — phpMyAdmin)
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=rocketpi
MYSQL_USER=rocketpi
MYSQL_PASSWORD=

REDIS_HOST=redis
REDIS_PASSWORD=
REDIS_PORT=6379

CACHE_DRIVER=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@rocketpi.pro"
MAIL_FROM_NAME="${APP_NAME}"

# Compte admin initial (utilisé par le seeder)
ADMIN_EMAIL=admin@rocketpi.pro
ADMIN_PASSWORD=

# Stripe (phase 5)
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

# Sanctum — domaines autorisés pour les cookies cross-domain
SANCTUM_STATEFUL_DOMAINS=rocketpi.pro,localhost

# Photon Fusion (phase 4)
PHOTON_APP_ID=
PHOTON_APP_SECRET=

# Horizon
HORIZON_USERNAME=
HORIZON_PASSWORD=

# Meshy.ai — pipeline 3D modulaire opérateurs (phase 6)
# Si MESHY_FAKE=true OU MESHY_API_KEY vide → FakeMeshyClient (placeholders).
# Sinon le service container bind MeshyHttpClient (vraie API, facturable).
MESHY_API_KEY=
MESHY_BASE_URL=https://api.meshy.ai
MESHY_FAKE=true
MESHY_TASK_TIMEOUT=1800
MESHY_POLL_INTERVAL=15
