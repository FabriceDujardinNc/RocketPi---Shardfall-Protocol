# Unity-generated folders (build cache, IDE files, temporary state)
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/
[Mm]emoryCaptures/
[Rr]ecordings/

# IDE / OS
.idea/
.vs/
.vscode/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
.DS_Store
Thumbs.db

# Unity Asset Store / packages cache
[Pp]ackages/[Pp]ackages-lock.json.meta
sysinfo.txt
crashlytics-build.properties

# Build artifacts (we copy WebGL output into ../public/unity/ from the build script)
WebGLBuild/

# WebGL build symbols (optional — keep if you want sourcemaps)
*.symbols.json.unityweb

# Meshy raw .glb sources — copies of storage/app/public/models/operators/*/base.glb
# Pas besoin de les versionner (118 MB de duplicates avec storage Laravel).
# Le pipeline /admin/operators/{slug}/assets régénère, et le user les recopie en local
# pour les import Unity. Pour CI/serveur, ils ne sont pas nécessaires.
Assets/Models/Operators/Raw/*.glb
Assets/Models/Operators/Raw/*.glb.meta

# Conversions intermédiaires (anyconv .obj utilisés pour upload Mixamo).
# Plain-text vertex data — chaque fichier fait 30-50 MB. À exclure absolument.
Assets/Models/Operators/Raw/raw-obj/
Assets/Models/Operators/Raw/raw-obj.meta

# Unity Recovery (auto-créé lors de crash éditeur)
Assets/_Recovery/
Assets/_Recovery.meta

# Mixamo character FBX (~286 MB total — Vex/Wraith ≈ 95 MB chacun).
# Re-télécharger depuis Mixamo "With Skin" et placer dans Assets/Models/Operators/Rigged/,
# puis Tools > RocketPi > Diagnose & Repair Operator Avatars pour reconfigurer/relink.
# YBot.fbx (placeholder partagé, 2 MB) reste tracké comme fallback.
Assets/Models/Operators/Rigged/*.fbx
Assets/Models/Operators/Rigged/*.fbx.meta
!Assets/Models/Operators/Rigged/YBot.fbx
!Assets/Models/Operators/Rigged/YBot.fbx.meta

# Textures + matériaux extraits des FBX Mixamo (263 MB de diffuse/normal).
# Régénérés par Tools > RocketPi > Extract Operator Textures (URP) après re-download
# des FBX. Garder Materials/Textures hors git → repo léger.
Assets/Models/Operators/Rigged/Textures/
Assets/Models/Operators/Rigged/Textures.meta
Assets/Models/Operators/Rigged/Materials/
Assets/Models/Operators/Rigged/Materials.meta
