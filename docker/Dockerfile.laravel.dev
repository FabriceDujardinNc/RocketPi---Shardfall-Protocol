FROM php:8.5-fpm-alpine

# ── System dependencies ────────────────────────────────────────────
RUN apk add --no-cache \
    bash \
    curl \
    git \
    zip \
    unzip \
    supervisor \
    libpng-dev \
    libjpeg-turbo-dev \
    freetype-dev \
    libzip-dev \
    icu-dev \
    oniguruma-dev \
    nodejs \
    npm

# ── PHP extensions (same runtime as prod) ─────────────────────────
RUN docker-php-ext-configure gd \
    --with-freetype \
    --with-jpeg \
    && docker-php-ext-install \
    pdo_mysql \
    intl \
    gd \
    zip \
    bcmath \
    mbstring \
    opcache \
    pcntl

RUN pecl install redis && docker-php-ext-enable redis

# ── Composer ───────────────────────────────────────────────────────
COPY --from=composer:2.7 /usr/bin/composer /usr/bin/composer

# ── PHP configuration ──────────────────────────────────────────────
COPY docker/php.ini /usr/local/etc/php/conf.d/rocketpi.ini

WORKDIR /var/www/html

# Code is bind-mounted at runtime — no COPY, no npm build, no artisan cache.
# npm install / composer install run on the host; vendor/ and node_modules/
# come in via the delegated volume mount.

EXPOSE 9000
CMD ["php-fpm"]
