# ── Laravel ─────────────────────────────────────────────────────────
/vendor/
/node_modules/
/public/build/
/public/hot
/public/storage
/storage/*.key
/storage/logs/
/storage/framework/cache/
/storage/framework/sessions/
/storage/framework/views/
/database/database.sqlite
.env
.env.backup
.env.production
.env.testing

# ── PHP ──────────────────────────────────────────────────────────────
*.log
*.cache

# ── OS ──────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── IDEs ─────────────────────────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo
*.code-workspace

# Claude Code local settings (machine-specific)
.claude/settings.local.json

# ── Docker ───────────────────────────────────────────────────────────
# docker-compose.override.yml EST committé : c'est le compose dev standard
# (auto-mergé par `docker compose up`). Ne pas l'ignorer.
.docker-secrets/

# ── Build outputs ────────────────────────────────────────────────────
# Unity WebGL build (public/unity/) EST committé — c'est le binaire qui sert
# directement à Laravel via nginx. Les .br/.gz sont les artefacts compressés
# normaux d'un build WebGL (Brotli activé dans FirstRunSetup.cs).

# ── Tests ────────────────────────────────────────────────────────────
.phpunit.result.cache
/coverage/
/storybook-static/

# ── Temp ─────────────────────────────────────────────────────────────
*.tmp
*.temp
/tmp/

# ── Secrets ──────────────────────────────────────────────────────────
*.pem
*.key
*.cert
*.p12
secrets.json
