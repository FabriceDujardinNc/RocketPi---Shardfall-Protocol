{
  "$schema": "https://rocketpi.pro/design-system/schema.json",
  "$version": "1.0.0",
  "$description": "RocketPi — Shardfall Protocol · Design Tokens. Single source of truth. All values in OKLCH for perceptual uniformity. Generated from Claude Design session 2026-05-10.",

  "brand": {
    "shard": {
      "$description": "Signature cyan — tweakable via --shard-hue (default 188)",
      "hue": 188,
      "50":  "oklch(0.97 0.04 188)",
      "100": "oklch(0.93 0.08 188)",
      "200": "oklch(0.88 0.12 188)",
      "300": "oklch(0.82 0.15 188)",
      "400": "oklch(0.76 0.17 188)",
      "500": "oklch(0.70 0.18 188)",
      "600": "oklch(0.62 0.17 188)",
      "700": "oklch(0.52 0.14 188)",
      "800": "oklch(0.40 0.10 188)",
      "900": "oklch(0.28 0.07 188)",
      "950": "oklch(0.18 0.04 188)"
    }
  },

  "factions": {
    "orbit": {
      "$description": "Ex-agence spatiale · bleu profond, hexagones, technophile",
      "hue": 220,
      "100": "oklch(0.92 0.06 220)",
      "300": "oklch(0.78 0.13 220)",
      "500": "oklch(0.62 0.18 220)",
      "700": "oklch(0.42 0.14 220)",
      "900": "oklch(0.24 0.08 220)"
    },
    "ferro": {
      "$description": "Milice indépendante · rouge rouille, brutaliste, armes lourdes",
      "hue": 32,
      "100": "oklch(0.92 0.05 32)",
      "300": "oklch(0.78 0.13 32)",
      "500": "oklch(0.66 0.18 32)",
      "700": "oklch(0.50 0.16 32)",
      "900": "oklch(0.28 0.09 32)"
    },
    "veil": {
      "$description": "Société secrète · violet sombre + vert acide",
      "hue": 290,
      "100": "oklch(0.92 0.05 290)",
      "300": "oklch(0.74 0.14 290)",
      "500": "oklch(0.56 0.20 290)",
      "700": "oklch(0.38 0.16 290)",
      "900": "oklch(0.22 0.10 290)",
      "acid": "oklch(0.82 0.22 140)"
    }
  },

  "rarities": {
    "common": {
      "foreground": "oklch(0.72 0.01 250)",
      "background": "oklch(0.30 0.01 250)"
    },
    "rare": {
      "foreground": "oklch(0.72 0.16 235)",
      "background": "oklch(0.32 0.12 235)",
      "glow": "0 0 16px oklch(0.72 0.16 235 / 0.55)"
    },
    "epic": {
      "foreground": "oklch(0.68 0.22 305)",
      "background": "oklch(0.30 0.16 305)",
      "glow": "0 0 20px oklch(0.68 0.22 305 / 0.60)"
    },
    "legendary": {
      "foreground": "oklch(0.82 0.16 85)",
      "background": "oklch(0.36 0.10 75)",
      "accent":     "oklch(0.70 0.18 188)",
      "glow": "0 0 28px oklch(0.82 0.16 85 / 0.70)"
    }
  },

  "semantic": {
    "success": "oklch(0.72 0.18 155)",
    "warning": "oklch(0.78 0.17 78)",
    "danger":  "oklch(0.66 0.22 25)",
    "info":    "oklch(0.68 0.16 235)"
  },

  "background": {
    "base":   "oklch(0.13 0.018 245)",
    "elev1":  "oklch(0.17 0.020 245)",
    "elev2":  "oklch(0.21 0.022 245)",
    "elev3":  "oklch(0.26 0.024 245)",
    "surfaceLine":       "oklch(0.32 0.02 245 / 0.6)",
    "surfaceLineStrong": "oklch(0.42 0.03 245 / 0.8)"
  },

  "text": {
    "high":   "oklch(0.97 0.01 235)",
    "medium": "oklch(0.78 0.02 235)",
    "low":    "oklch(0.58 0.02 235)",
    "dim":    "oklch(0.40 0.02 235)",
    "onShard":"oklch(0.13 0.02 245)"
  },

  "border": {
    "subtle":  "oklch(0.30 0.02 245 / 0.5)",
    "default": "oklch(0.42 0.03 245 / 0.7)",
    "strong":  "oklch(0.62 0.05 245)",
    "shard":   "oklch(0.70 0.18 188 / 0.7)"
  },

  "typography": {
    "fonts": {
      "display": "\"Chakra Petch\", \"Rajdhani\", system-ui, sans-serif",
      "body":    "\"Inter\", system-ui, -apple-system, sans-serif",
      "mono":    "\"JetBrains Mono\", ui-monospace, monospace"
    },
    "fontSizes": {
      "xs":      "0.6875rem",
      "sm":      "0.8125rem",
      "base":    "0.9375rem",
      "md":      "1.0625rem",
      "lg":      "1.25rem",
      "xl":      "1.5rem",
      "2xl":     "2rem",
      "3xl":     "2.75rem",
      "display": "4rem"
    },
    "fontWeights": {
      "regular":  400,
      "medium":   500,
      "semibold": 600,
      "bold":     700
    },
    "lineHeights": {
      "tight":   1.1,
      "snug":    1.25,
      "normal":  1.5,
      "relaxed": 1.7
    },
    "letterSpacings": {
      "tight":  "-0.02em",
      "normal": "0",
      "wide":   "0.04em",
      "mega":   "0.16em"
    }
  },

  "spacing": {
    "$description": "4px base grid. Values 0–64 (rem). Use Tailwind utilities: p-4 = 16px.",
    "0":  "0",
    "1":  "0.25rem",
    "2":  "0.5rem",
    "3":  "0.75rem",
    "4":  "1rem",
    "5":  "1.25rem",
    "6":  "1.5rem",
    "8":  "2rem",
    "10": "2.5rem",
    "12": "3rem",
    "16": "4rem",
    "20": "5rem",
    "24": "6rem",
    "32": "8rem",
    "40": "10rem",
    "48": "12rem",
    "64": "16rem"
  },

  "borderRadius": {
    "sm":   "0.1875rem",
    "md":   "0.375rem",
    "lg":   "0.625rem",
    "xl":   "1rem",
    "full": "999px"
  },

  "elevation": {
    "1": "0 1px 0 oklch(1 0 0 / 0.04) inset, 0 1px 2px oklch(0 0 0 / 0.40)",
    "2": "0 1px 0 oklch(1 0 0 / 0.05) inset, 0 4px 12px oklch(0 0 0 / 0.45)",
    "3": "0 1px 0 oklch(1 0 0 / 0.06) inset, 0 12px 28px oklch(0 0 0 / 0.55)",
    "4": "0 1px 0 oklch(1 0 0 / 0.07) inset, 0 24px 56px oklch(0 0 0 / 0.60)",
    "5": "0 1px 0 oklch(1 0 0 / 0.08) inset, 0 40px 88px oklch(0 0 0 / 0.70)"
  },

  "glows": {
    "shard":  "0 0 20px oklch(0.70 0.18 188 / 0.55)",
    "rare":   "0 0 16px oklch(0.72 0.16 235 / 0.55)",
    "epic":   "0 0 20px oklch(0.68 0.22 305 / 0.60)",
    "legend": "0 0 28px oklch(0.82 0.16 85  / 0.70)"
  },

  "animation": {
    "durations": {
      "fast":      "120ms",
      "normal":    "220ms",
      "slow":      "400ms",
      "cinematic": "1200ms"
    },
    "easings": {
      "out":    "cubic-bezier(0.2, 0.7, 0.3, 1)",
      "in":     "cubic-bezier(0.5, 0, 0.95, 0.5)",
      "inout":  "cubic-bezier(0.65, 0, 0.35, 1)",
      "spring": "cubic-bezier(0.34, 1.4, 0.64, 1)"
    }
  },

  "zIndex": {
    "base":     0,
    "dropdown": 100,
    "sticky":   200,
    "overlay":  400,
    "modal":    500,
    "toast":    600,
    "tooltip":  700
  }
}
